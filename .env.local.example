# Copy to .env.local for local dev (via `vercel dev`) and never commit it.
# In production, set these as Environment Variables in the Vercel project
# dashboard instead — not in a file.

# HubSpot private app access token (Settings -> Integrations -> Private Apps).
# Required scopes: crm.objects.companies.read, crm.schemas.companies.read,
# crm.objects.owners.read, settings.users.teams.read
HUBSPOT_ACCESS_TOKEN=

# Optional. If set, the dashboard requires this key (entered once in the
# Settings panel, stored in that browser's localStorage) before the proxy
# will forward any request. Leave blank for a fully open link.
DASHBOARD_ACCESS_KEY=
